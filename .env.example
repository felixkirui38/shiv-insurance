# Server
PORT=5000
NODE_ENV=development

# CMS admin login (required)
CMS_USERNAME=
CMS_PASSWORD=

# Session encryption (required — use a long random string)
SESSION_SECRET=

# Set to "true" only when serving over HTTPS in production
COOKIE_SECURE=false

# Email delivery (required for lead + confirmation emails)
# cPanel on SAME Coolify VPS (recommended when ECONNREFUSED happens):
#   Coolify → Application → Network → Host
#   SMTP_HOST=127.0.0.1
SMTP_HOST=127.0.0.1
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@shivinsbro.co.ke
SMTP_PASS=
SMTP_FROM=info@shivinsbro.co.ke
SMTP_TLS_REJECT_UNAUTHORIZED=false
# Optional: comma-separated extra hosts to probe (auto-tried on ECONNREFUSED)
# SMTP_HOST_FALLBACKS=host.docker.internal,172.17.0.1,172.18.0.1
# Optional: TLS server name when connecting via IP
SMTP_TLS_SERVERNAME=mail.shivinsbro.co.ke

# Database (REQUIRED — app creates CMS tables on startup via ensureSchema)
# Production / Coolify (use the INTERNAL Docker hostname from Coolify DB):
# DATABASE_URL=postgres://postgres:PASSWORD@jght6ihq5l8w5jw7bpc89dik:5432/postgres
#
# Local development (public IP + mapped host port, e.g. 5433):
# DATABASE_URL=postgres://postgres:PASSWORD@161.97.120.166:5433/postgres?sslmode=disable
DATABASE_URL=

# --- Coolify / production deployment ---
# In Coolify → Application → Environment Variables, set at minimum:
#   DATABASE_URL    (use the internal postgres://... URL from Coolify)
#   SESSION_SECRET  (long random string)
#   CMS_USERNAME    (e.g. shiv_2026)
#   CMS_PASSWORD    (your CMS password)
#   COOKIE_SECURE=true   (when using HTTPS on shivinsbro.co.ke)
#   SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM
# Port: expose container port 5000 (matches PORT above; Coolify proxy routes to this)
