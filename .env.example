# Server
PORT=5000
NODE_ENV=development

# CMS admin login (required)
CMS_USERNAME=
CMS_PASSWORD=

# Session encryption (required — use a long random string)
SESSION_SECRET=

# Set to "true" only when serving over HTTPS in production
COOKIE_SECURE=false

# Email delivery (optional — forms still save to CMS without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Database (required only for drizzle-kit migrations / PostgreSQL features)
DATABASE_URL=
